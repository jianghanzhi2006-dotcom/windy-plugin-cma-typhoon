{
    "name": "windy-plugin-cma-typhoon",
    "version": "1.0.2",
    "description": "Windy plugin for CMA typhoon tracks using the GB/T 28591-2012 wind scale and a labeled extended Level 18",
    "main": "dist/plugin.min.js",
    "type": "module",
    "scripts": {
        "build": "node scripts/build.js",
        "start": "npx rollup -w -c",
        "test": "tsc -p tsconfig.test.json && node --test tests/typhoon-logic.test.mjs",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jianghanzhi2006-dotcom/windy-plugin-cma-typhoon.git"
    },
    "keywords": [
        "windy",
        "windy.com",
        "plugins",
        "typhoon",
        "cma"
    ],
    "author": "jianghanzhi2006-dotcom",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/jianghanzhi2006-dotcom/windy-plugin-cma-typhoon/issues"
    },
    "homepage": "https://docs.windy-plugins.com/",
    "dependencies": {
        "@windycom/plugin-devtools": "^3.0.3"
    },
    "devDependencies": {
        "typescript": "5.9.3"
    }
}
