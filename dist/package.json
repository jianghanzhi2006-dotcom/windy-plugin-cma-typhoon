{
    "name": "windy-plugin-cma-typhoon",
    "version": "1.0.0",
    "description": "Windy plugin for tracking typhoon with CMA data, 18-level Beaufort scale and color-coded tracks",
    "main": "dist/plugin.min.js",
    "type": "module",
    "scripts": {
        "build": "node scripts/build.js",
        "start": "npx rollup -w -c",
        "example01": "CONFIG=example01 rollup -w -c",
        "example02": "CONFIG=example02 rollup -w -c",
        "example03": "CONFIG=example03 rollup -w -c",
        "example04": "CONFIG=example04 rollup -w -c",
        "example05": "CONFIG=example05 rollup -w -c",
        "example06": "CONFIG=example06 rollup -w -c",
        "example07": "CONFIG=example07 rollup -w -c",
        "build:all-examples": "for number in 01 02 03 04 05 06; do CONFIG=example$number SERVE=false rollup -c; done",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jianghanzhi2006-dotcom/windy-plugin-cma-typhoon.git"
    },
    "keywords": [
        "windy",
        "windy.com",
        "plugins"
    ],
    "author": "jianghanzhi2006-dotcom",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/jianghanzhi2006-dotcom/windy-plugin-cma-typhoon/issues"
    },
    "homepage": "https://docs.windy-plugins.com/",
    "dependencies": {
        "@windycom/plugin-devtools": "^3.0.3"
    }
}